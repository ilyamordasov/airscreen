<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AirTV" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg_dashboard</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
    <style name="Theme.FreeCast.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowMinWidthMajor">75%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/FreeCast.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/FreeCast.DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/FreeCast.DialogButton</item>
    </style>
    <style name="FreeCast.ActionButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="FreeCast.PrimaryButton" parent="FreeCast.ActionButton">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>
    <style name="FreeCast.NavButton" parent="FreeCast.ActionButton">
        <item name="android:background">@drawable/bg_nav</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:minHeight">54dp</item>
    </style>
    <style name="FreeCast.TileButton" parent="FreeCast.ActionButton">
        <item name="android:textSize">21sp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">114dp</item>
    </style>
    <style name="FreeCast.DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="FreeCast.StepNumber" parent="">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_step</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="FreeCast.StepText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="FreeCast.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="FreeCast.RadioChoice" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:buttonTint">@color/accent</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
