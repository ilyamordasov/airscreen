<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black" android:focusable="true" android:focusableInTouchMode="true">
    <SurfaceView android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/bg_dashboard">
        <LinearLayout android:id="@+id/receiver_details" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingStart="48dp" android:paddingTop="28dp"
            android:paddingEnd="48dp" android:paddingBottom="32dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="54dp" android:layout_height="50dp"
                    android:src="@drawable/dashboard_logo" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:text="@string/dashboard_receiver"
                    android:textColor="@color/foreground" android:textSize="30sp" android:fontFamily="sans-serif-medium" />
                <Button android:id="@+id/receiver_back" style="@style/FreeCast.ActionButton"
                    android:layout_width="128dp" android:layout_height="48dp" android:text="@string/dashboard_back" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="20dp" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.32"
                    android:background="@drawable/bg_receiver_card" android:orientation="vertical" android:padding="24dp">
                    <TextView android:id="@+id/receiver_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/app_name" android:textColor="@color/foreground" android:fontFamily="sans-serif-medium"
                        android:textSize="34sp" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/connection_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:textColor="@color/muted" android:textSize="15sp" />
                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite" android:maxLines="2" android:ellipsize="end"
                        android:text="@string/status_starting" android:textColor="@color/foreground"
                        android:fontFamily="sans-serif-medium" android:textSize="22sp" />
                    <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:maxLines="4" android:ellipsize="end"
                        android:text="@string/detail_starting" android:textColor="@color/muted" android:textSize="15sp" />
                    <Button android:id="@+id/toggle_receiver" style="@style/FreeCast.PrimaryButton"
                        android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp"
                        android:nextFocusRight="@id/quick_share" android:text="@string/action_start" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.68"
                    android:layout_marginStart="16dp" android:orientation="vertical" android:background="@drawable/bg_card"
                    android:padding="20dp">
                    <Button android:id="@+id/quick_share" style="@style/FreeCast.ActionButton"
                        android:layout_width="match_parent" android:layout_height="58dp"
                        android:nextFocusLeft="@id/toggle_receiver" android:text="@string/dashboard_send_link" />
                    <Button android:id="@+id/resume_button" style="@style/FreeCast.ActionButton"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
                        android:text="@string/action_resume" android:visibility="gone" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="@string/guide_network"
                        android:textColor="@color/muted" android:textSize="15sp" />
                    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                    <Button android:id="@id/exit_button" style="@style/FreeCast.ActionButton"
                        android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/action_exit" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/playback_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="28dp"
        android:background="@drawable/bg_floating" android:paddingStart="22dp" android:paddingTop="12dp"
        android:paddingEnd="22dp" android:paddingBottom="12dp" android:text="@string/playback_controls_hint"
        android:textColor="@color/foreground" android:textSize="16sp" android:visibility="gone" />
</FrameLayout>
