<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard" android:orientation="horizontal">
    <LinearLayout android:id="@id/nav_rail" android:layout_width="192dp" android:layout_height="match_parent"
        android:orientation="vertical" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="38dp" android:paddingTop="30dp"
        android:paddingEnd="42dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FREECAST  •  СПОРТ" android:textColor="@color/accent" android:textSize="13sp"
            android:letterSpacing="0.13" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Трансляции" android:textColor="@color/foreground"
            android:textSize="39sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/broadcasts_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Загружаем трансляции…" android:textColor="@color/muted"
            android:textSize="15sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="22dp" android:fillViewport="true">
            <LinearLayout android:id="@+id/broadcasts_tiles" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/ace_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Проверяем Ace Stream…" android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:id="@+id/directory_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Проверяем каталог P2P…"
                android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>
        <Button android:id="@+id/broadcasts_refresh" style="@style/FreeCast.ActionButton"
            android:layout_width="210dp" android:layout_height="56dp" android:layout_marginTop="12dp"
            android:text="Обновить" />
    </LinearLayout>
</LinearLayout>
