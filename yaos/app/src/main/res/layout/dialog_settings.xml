<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:overScrollMode="ifContentScrolls">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="8dp"
        android:paddingEnd="24dp" android:paddingBottom="12dp">
        <TextView style="@style/FreeCast.FieldLabel" android:labelFor="@id/settings_name" android:text="@string/settings_name_label" />
        <EditText android:id="@+id/settings_name" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:importantForAutofill="no"
            android:imeOptions="actionDone" android:inputType="textCapSentences|textNoSuggestions"
            android:maxLength="48" android:maxLines="1" android:nextFocusDown="@id/quality_1080"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:selectAllOnFocus="true" android:singleLine="true"
            android:textColor="@color/foreground" android:textColorHint="@color/muted" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/settings_name_hint" android:textColor="@color/muted" android:textSize="13sp" />
        <TextView style="@style/FreeCast.FieldLabel" android:layout_marginTop="18dp" android:text="@string/settings_resolution" />
        <RadioGroup android:id="@+id/settings_resolution" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <RadioButton android:id="@+id/quality_720" style="@style/FreeCast.RadioChoice"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="@string/settings_720p" />
            <RadioButton android:id="@+id/quality_1080" style="@style/FreeCast.RadioChoice"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="12dp"
                android:layout_weight="1" android:text="@string/settings_1080p" />
        </RadioGroup>
        <TextView style="@style/FreeCast.FieldLabel" android:layout_marginTop="18dp" android:text="@string/settings_framerate" />
        <RadioGroup android:id="@+id/settings_framerate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <RadioButton android:id="@+id/fps_30" style="@style/FreeCast.RadioChoice"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="@string/settings_30fps" />
            <RadioButton android:id="@+id/fps_60" style="@style/FreeCast.RadioChoice"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="12dp"
                android:layout_weight="1" android:text="@string/settings_60fps" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp" android:text="@string/settings_quality_hint"
            android:textColor="@color/muted" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp" android:text="@string/settings_restart_hint"
            android:textColor="@color/foreground" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
