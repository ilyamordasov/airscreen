<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/focus_surface" /><stroke android:width="3dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape></item>
    <item android:state_checked="true"><shape android:shape="rectangle"><solid android:color="#7840274B" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape></item>
    <item ><shape android:shape="rectangle"><solid android:color="#A5343B5F" /><stroke android:width="1dp" android:color="@color/border" /><corners android:radius="16dp" /></shape></item>
</selector>
