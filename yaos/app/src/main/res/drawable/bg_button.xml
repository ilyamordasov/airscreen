<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#50272A47" /><corners android:radius="16dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/focus_surface" /><stroke android:width="3dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#E4D5FF" /><corners android:radius="16dp" /></shape></item>
    <item><shape><solid android:color="#C1252844" /><stroke android:width="1dp" android:color="@color/border" /><corners android:radius="16dp" /></shape></item>
</selector>
