<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="#17312F" /><stroke android:width="1dp" android:color="#31504D" /><corners android:radius="9dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#34786E" /><stroke android:width="2dp" android:color="#BBFFF2" /><corners android:radius="9dp" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#2A625B" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="9dp" /></shape></item>
    <item ><shape android:shape="rectangle"><solid android:color="#214D47" /><stroke android:width="1dp" android:color="#4B8B7F" /><corners android:radius="9dp" /></shape></item>
</selector>
